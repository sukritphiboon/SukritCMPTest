# --- PostgreSQL ---
POSTGRES_USER=cmp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cmp
CMP_DATABASE_URL=postgresql+asyncpg://cmp:change-me@postgres:5432/cmp

# --- Redis (ARQ worker) ---
CMP_REDIS_URL=redis://redis:6379/0

# --- Encryption key for device credentials (AES-256-GCM) ---
# Generate with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CMP_ENCRYPTION_KEY=

# --- Telemetry ---
# Polling interval in seconds; must divide 60 (30 = every half minute)
CMP_TELEMETRY_INTERVAL_SECONDS=30
CMP_RUNWAY_WINDOW_DAYS=7
# How often running backups are checked on the appliances (must divide 60)
CMP_JOB_POLL_INTERVAL_SECONDS=15

# --- Backup schedule (the cron of each backup policy) ---
CMP_SCHEDULER_ENABLED=true
# One timezone for all policy schedules: "0 1 * * *" means 01:00 in this zone
CMP_SCHEDULER_TIMEZONE=Asia/Bangkok
# A changed policy takes effect within this many seconds
CMP_SCHEDULER_SYNC_SECONDS=30
# A run that could not start this long after its time is skipped
CMP_SCHEDULER_MISFIRE_GRACE_SECONDS=300
CMP_SCHEDULER_MAX_PARALLEL_STARTS=4

# --- Mock server ---
MOCK_USERNAME=admin
MOCK_PASSWORD=Admin@storage1

# --- API access ---
# "user:key,user2:key2" - send the key as header  X-API-Key ; the user name is stored in the audit log
CMP_API_KEYS=admin:change-me-please
# Arrays are reached over https by default. The bundled mock servers speak plain http.
CMP_DEVICE_HTTPS=false
CMP_DEVICE_VERIFY_TLS=false
